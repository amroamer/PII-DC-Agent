# --- Database -------------------------------------------------------------
# Postgres 16. Local dev default matches docker-compose (db/pdtc/pdtc).
DATABASE_URL=postgres://pdtc:pdtc@localhost:5432/pdtc

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Secret for express-session cookies. Change in any real deployment.
# Also used (by default) to encrypt an API key saved through Settings → AI.
SESSION_SECRET=dev-only-change-me

# Optional: dedicated master secret for encrypting stored secrets (the AI API key).
# If unset, SESSION_SECRET is used. Set a strong value in production. Rotating it
# invalidates any stored API key, which then falls back to OPENAI_API_KEY below.
# SETTINGS_ENCRYPTION_KEY=

# --- AI provider (OpenAI-compatible Chat Completions) ---------------------
# The provider is intentionally OpenAI-API-compatible so PDTC can run against a
# LOCAL / self-hosted inference endpoint (Ollama / vLLM / LiteLLM) and keep all
# metadata inside the ADC boundary. Leave OPENAI_BASE_URL pointing at localhost
# for data sovereignty. If unset/unreachable, the PII engine's LLM layer degrades
# to an "uncertain" signal instead of crashing a run.
OPENAI_API_KEY=not-required-for-local-endpoints
OPENAI_MODEL=llama3.1
OPENAI_BASE_URL=http://localhost:11434/v1
